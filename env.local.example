# Copy to .env.local and fill in. Never commit .env.local.

# --- Agora (required) --------------------------------------------------------
# Agora Console → your project (RTC, RTM/Signaling and Conversational AI enabled).
# Or run: agora project env write .env.local
NEXT_PUBLIC_AGORA_APP_ID=
# Server-side only. Never expose it in client code.
NEXT_AGORA_APP_CERTIFICATE=

# --- Murf Falcon text-to-speech (required) -----------------------------------
# https://murf.ai/api/dashboard
MURF_API_KEY=
# Optional: any Falcon voice with an en-IN locale. Default: Anusha
# MURF_VOICE_ID=Anusha

# --- Agent tools (required for Vigil to act) ---------------------------------
# Agora's cloud calls /api/tools/* during the call, so this must be public HTTPS:
# your Vercel URL, or a tunnel to localhost (cloudflared tunnel --url http://localhost:3000).
PUBLIC_BASE_URL=
# Shared secret sent with every tool call (at least 16 characters): openssl rand -hex 24
TOOL_SECRET=

# --- Storage on Vercel (required there; local dev uses .data/) ----------------
# Upstash Redis (Vercel → Storage → Upstash). Either naming works:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Public-demo limits (optional) -------------------------------------------
# Calls per visitor sandbox (default 6) and per day across everyone (default 150).
# MAX_CALLS_PER_SANDBOX=6
# DAILY_CALL_CAP=150
# Your own devices skip the limits: open /console?owner=<OWNER_KEY> once.
# OWNER_KEY=
# Agora-managed LLM (default gpt-4.1-mini)
# AGENT_LLM_MODEL=gpt-4.1-mini
